# 复制为 .env 后按需修改;`docker compose` 自动读取。
# 改完执行 `docker compose up -d` 生效(重建容器,模型不重下)。

# ---------- 模型选择 ----------

# NVFP4 家族(本 fork 的核心):
#   qwen-nvfp4-gptq  原版权重,GPTQ 量化,93.6% 保真 —— 默认推荐
#   qwen-nvfp4-mix   38/48 层 Q8_0,95.0% 保真,需 128G 内存(105-108G 占用)
#   qwen-q8          全专家 Q8_0,100% 参照,46 tok/s,质量天花板
#   orca-nvfp4       已撤回(可用但官方不再提供)
#   以上家族 MODEL 固定为 NVFP4,不要改。
FAMILY=qwen-nvfp4-gptq
MODEL=NVFP4

# 审查开关:on = 默认无审查(运行时还可在 web 界面 "Disable censorship" 随时切换)。
#   仅对 qwen-nvfp4-gptq / qwen-nvfp4-mix / qwen-q8 / qwen / unsloth 家族生效;
#   NVIDIA 转换包与 Swift/Coder 不支持(官方策略)。修改默认需配 REINSTALL=1 一次。
UNCENSORED=on

# 上游 GGUF 家族(改用原版档位时的示例):
#   MODEL=IQ3_S(去掉 FAMILY 行)—— 90.0%,速度最快(约 200 tok/s)
#   MODEL=UD-IQ4_XS  + FAMILY=unsloth —— 93.5-94%(插值)
#   MODEL=UD-Q4_K_XL + FAMILY=unsloth —— 94.1%
#MODEL=IQ3_S
#FAMILY=unsloth

# ---------- 通用 ----------

# 上下文长度(token)。262144 为模型训练最大值。
CONTEXT=262144
# 一次性开关:修改已安装模型的设置(视觉/审查默认/KV 等)时临时打开,用完删除。
#REINSTALL=1

# 视觉(图像理解):yes 开启 | no 关闭 | cpu 编码器走 CPU。修改需配 REINSTALL=1 一次。
VISION=yes

# API 密钥:端口映射为 0.0.0.0(局域网可达)时必须设置(AGENTS.md)。
#   修改需配 REINSTALL=1 一次。此文件不入 git,真实密钥写在这里没问题。
#API_KEY=改成你的密钥

# 宿主机映射端口(局域网访问 http://<本机IP>:HOST_PORT)。容器内部固定 8080。
HOST_PORT=8089

# ---------- 下载与 Python 源(国内环境,保持不动) ----------

# NVFP4 包来自 Hugging Face(Maximilian228 仓库);本机已预置离线文件,
#   正常情况不会触发下载。若真需要在线下载,本机只能走 hf-mirror(时好时坏)。
STRATA_SOURCE=modelscope
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- 引擎调优(可选) ----------

# 自适应层拷贝与解码窗口重叠(0.1.43 的默认;0.1.42 引擎上手动开启,
#   对 NVFP4/UD 这类内存驻留档有益)。1 开启 | 0 关闭。
STRATA_ADAPT_OVERLAP=1

# 路由 tail skip:NVFP4 包默认关闭(保守);GGUF 档沿用上游默认。
#   强制开启设 7(官方 NVFP4 实测 +11.5% decode,回答会轻微偏移)。
#STRATA_ROUTE_TAIL_SKIP=7

# ---------- 其他(一般不用) ----------

# GPU=0 指定单卡;GPUS=0,1 多卡切层;LOW_RAM=auto 自动;KV=int8。
#GPU=
#GPUS=
#KV=
#LOW_RAM=auto
#HOST=0.0.0.0
#PORT=8080
