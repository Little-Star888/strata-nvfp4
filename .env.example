# cn 部署配置模板(deploy/v0.2.0-beta-nvfp4-cn,0.2.0-beta 镜像)。
# 复制为 .env 后填写;真实密钥写在这里没问题(/.env 已 gitignore)。

# 模型档位与家族(0.2.0 官方目录名)。默认 UD-Q4_K_XL(93.0%,本机实测四项质量全胜 GPTQ)。
# 已有 GGUF 直接用(MODEL_PATH 指向分片目录,不重新下载)。
MODEL=UD-Q4_K_XL
FAMILY=unsloth
MODEL_PATH=/data/models/unsloth-UD-Q4_K_XL

# 上下文:524288 = 512K(>262144 时 setup 自动写 dynamic RoPE,NVIDIA 单卡单对话)。
CONTEXT=524288

# KV 缓存格式:int8(推荐)/ q4_0 / k8v4 / fp16
KV=int8

# 视觉:on(GPU 编码,占专家缓存约 2.2G)/ cpu / off
VISION=on

# API 密钥(≥16 字符;端口发布在 0.0.0.0 必须设置)
API_KEY=change-me

# 宿主机端口
HOST_PORT=8089

# 并发批槽数(1~8,空=按显存自动;每个槽的上下文 = max-context/N)
#PARALLEL=

# 首启调优:skip(默认,快)/ quick / thorough(一次性的内核调优,耗时)
TUNE=skip
